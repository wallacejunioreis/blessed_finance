# Ambiente da aplicação: development | test | production
APP_ENV=development

# URL pública da aplicação (opcional; preenchida automaticamente em produção)
APP_URL=

# Origens permitidas adicionais separadas por vírgula (opcional)
ALLOWED_ORIGINS=

# Serviço de e-mail para recuperação de senha (configure SMTP ou Resend apenas no servidor)
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
